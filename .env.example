# Global defaults shared across apps/packages
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_dev?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="1d"
ADMIN_NAME="ERP Admin"
ADMIN_EMAIL="admin@erp.local"
ADMIN_PASSWORD="Admin@123"

# Future integrations
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
SENTRY_DSN=""

# SPOT (Stricker Europe) — catálogo de orçamentos
SPOT_ACCESS_KEY=
SPOT_CLIENT_ID=
SPOT_BASE_URL=https://ws.spotgifts.com.br/api/v1SSL

# Ásia Imports — catálogo de orçamentos
ASIA_IMPORTS_API_URL=https://api.asiaimport.com.br/
ASIA_IMPORTS_USER=
ASIA_IMPORTS_KEY=

# Importação automática WEG (robô / cron externo) — header X-Import-Api-Key
IMPORT_API_KEY=

# Robô Flask de emissão de NF (ex.: túnel ngrok apontando para a máquina local)
FLASK_NF_URL=

# Orçamentos — e-mail (ou id) da Julia para ver/editar margem de venda (confidencial)
QUOTE_MARGIN_USER_EMAIL=gestao@energybrands.com.br
# Espelho no frontend (Next.js) — mesmo valor
NEXT_PUBLIC_QUOTE_MARGIN_USER_EMAIL=gestao@energybrands.com.br

# Conta Azul API v2 (OAuth2 — app de desenvolvimento / conta de teste)
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REDIRECT_URI=https://contaazul.com
CONTA_AZUL_TEST_USER=
CONTA_AZUL_TEST_PASSWORD=